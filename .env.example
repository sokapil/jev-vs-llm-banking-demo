# --- TypeSafe / Jev ---
TYPESAFE_API_KEY=replace_me
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# Your current promotional balance shown in TypeSafe Billing.
# Display-only: this app does not query TypeSafe billing.
JEV_CREDIT_BALANCE_USD=5.00
JEV_SESSION_BUDGET_USD=1.00
JEV_INPUT_PRICE_PER_M=0.042

# --- Microsoft Foundry / Azure OpenAI comparison model ---
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=replace_me

AZURE_OPENAI_DEPLOYMENT_TERRA=replace_me
AZURE_OPENAI_DEPLOYMENT_SOL=replace_me
AZURE_OPENAI_COMPARATOR=terra

AZURE_OPENAI_REASONING_EFFORT=medium
AZURE_OPENAI_MAX_OUTPUT_TOKENS=1200
AZURE_OPENAI_INPUT_OVERHEAD_TOKENS=2200

# AZURE_OPENAI_DEPLOYMENT=your_exact_deployment_name
LLM_SESSION_BUDGET_USD=1.50

AZURE_GPT_5_6_TERRA_INPUT_PER_M=2.00
AZURE_GPT_5_6_TERRA_OUTPUT_PER_M=12.00
AZURE_GPT_5_6_SOL_INPUT_PER_M=4.00
AZURE_GPT_5_6_SOL_OUTPUT_PER_M=20.00

# --- App ---
PORT=8010
BENCHMARK_CONCURRENCY=8
MOCK_MODE=true
